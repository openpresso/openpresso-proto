{
  "name": "@openpresso/proto",
  "version": "0.0.0",
  "description": "OpenPresso protobuf messages and gRPC-Web clients",
  "license": "GPL-3.0-or-later",
  "author": "Openpresso",
  "homepage": "https://openpresso.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpresso/openpresso-proto.git"
  },
  "type": "commonjs",
  "main": "./npm-dist/openpresso_proto/openpresso_grpc_web_pb.js",
  "types": "./npm-dist/openpresso_proto/openpresso_grpc_web_pb.d.ts",
  "exports": {
    ".": {
      "types": "./npm-dist/openpresso_proto/openpresso_grpc_web_pb.d.ts",
      "default": "./npm-dist/openpresso_proto/openpresso_grpc_web_pb.js"
    },
    "./*": {
      "types": "./npm-dist/openpresso_proto/*.d.ts",
      "default": "./npm-dist/openpresso_proto/*.js"
    }
  },
  "files": [
    "npm-dist/**/*.js",
    "npm-dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pregenerate": "rm -rf npm-dist && mkdir -p npm-dist",
    "generate": "protoc -I=src --js_out=import_style=commonjs,binary:npm-dist --grpc-web_out=import_style=commonjs+dts,mode=grpcwebtext:npm-dist src/openpresso_proto/*.proto",
    "prepack": "npm run generate"
  },
  "dependencies": {
    "@types/google-protobuf": "^3.15.12",
    "google-protobuf": "^4.0.3",
    "grpc-web": "^2.0.2"
  }
}
